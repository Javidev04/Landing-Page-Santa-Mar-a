---
import "../styles/global.css";
import logo from "../assets/logo.png"
import fondo_principal from "../assets/fondo_principal.avif"
import imagen_contactos from "../assets/imagen_contactos.png"
import imagen_principal from "../assets/imagen_principal.png"

const products = [
	{ name: "Bidón retornable", volume: "20 L", image: "20" },
	{ name: "Bidón retornable", volume: "10 L", image: "10" },
	{ name: "Bidón no retornable", volume: "7 L", image: "7" },
	{ name: "Bidón no retornable", volume: "5 L", image: "5" },
	{ name: "Pack de botellas", volume: "12 x 1 L", image: "1" },
	{ name: "Pack de botellas", volume: "12 x 500 ml", image: "0.5" },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Agua Santa María: agua purificada y distribución a domicilio en Lima." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Santa María | Agua purificada</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body class="m-0 bg-white font-[DM_Sans,sans-serif] text-[#183b50]">
		<header class="site-header fixed top-0 z-20 flex h-21 w-full items-center gap-7.5 border-b border-transparent bg-transparent px-[5.5%] transition-colors duration-500 ease-in-out max-[760px]:h-17.5 max-[760px]:justify-between max-[760px]:px-[5%]">
			<a class="py-2 rounded-xl flex min-w-51.25 items-center justify-center gap-2.25 max-[760px]:min-w-0" href="#" aria-label="Santa María, inicio">
				<img src={logo.src} alt="Logo de Agua Santa María" class="h-7.25" />
			</a>
			<nav class="nav ml-auto flex items-center gap-[clamp(18px,2vw,34px)] max-[760px]:absolute max-[760px]:left-0 max-[760px]:right-0 max-[760px]:top-17.5 max-[760px]:max-h-0 max-[760px]:overflow-hidden max-[760px]:border-b max-[760px]:border-[#e4edef] max-[760px]:bg-white max-[760px]:px-[5%] max-[760px]:py-0 max-[760px]:opacity-0 max-[760px]:-translate-y-2 max-[760px]:pointer-events-none max-[760px]:transition-[max-height,opacity,transform,padding] max-[760px]:duration-300 max-[760px]:ease-out max-[760px]:flex-col max-[760px]:motion-reduce:transition-none [&>a]:text-[14px] [&>a]:font-semibold [&>a]:text-white [&>a]:transition-colors [&>a]:duration-500 hover:[&>a]:text-sky-200 max-[1000px]:[&>a]:text-[12px] max-[760px]:[&>a]:text-[#446174]" aria-label="Navegación principal">
				<a href="#inicio">Inicio</a>
				<a href="#catalogo">Catálogo</a>
				<a href="#cobertura">Cobertura</a>
				<a href="#contacto">Contáctanos</a>
				<a href="#reclamaciones">Libro de reclamaciones</a>
			</nav>
			<button class="h-10.5 cursor-pointer rounded-md border border-[#b8d3df] bg-white px-4.5 font-bold text-[#0879b8] transition-[background-color,color,border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-[#0879b8] hover:bg-[#0879b8] hover:text-white hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0879b8] motion-reduce:transition-none motion-reduce:hover:transform-none max-[1000px]:hidden" type="button">Acceso personal</button>
			<button class="menu-button hidden size-10 flex-col items-center justify-center gap-1.25 border-0 bg-transparent max-[760px]:flex" type="button" aria-label="Abrir menú" aria-expanded="false">
				<span class="h-0.5 w-6 bg-white transition-colors duration-500"></span><span class="h-0.5 w-6 bg-white transition-colors duration-500"></span><span class="h-0.5 w-6 bg-white transition-colors duration-500"></span>
			</button>
		</header>

		<main>
			<section class="relative flex min-h-[calc(100svh)] items-center justify-center overflow-hidden max-[760px]:min-h-[calc(100svh)]" id="inicio">
				<img src={fondo_principal.src} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_40%]" />
				<div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/55"></div>
				<div class="flex flex-col items-center px-6 py-[clamp(2rem,8vh,5.125rem)] text-center">
					<p class="mb-3.5 text-[12px] font-extrabold tracking-[2.2px] text-sky-200">AGUA PURIFICADA A DOMICILIO</p>
					<h1 class="m-0 font-[Manrope] text-[clamp(58px,5vw,82px)] font-extrabold leading-[1.02] tracking-[-3px] text-white max-[760px]:text-[48px] max-[480px]:text-[40px]">La frescura que<br /><span class="text-sky-300">cuida tu hogar</span></h1>
					<p class="mb-7 mt-6 max-w-120 text-[18px] leading-[1.65] text-white/90 max-[480px]:text-[16px] max-[480px]:mx-12">Distribución segura, rápida y confiable de agua purificada para toda tu familia.</p>
					<div class="flex items-center justify-center gap-7 max-[480px]:flex-col max-[480px]:gap-3">
						<a class="inline-flex min-h-13 items-center justify-center gap-5.5 rounded-md border-0 bg-[#0879b8] px-5.5 font-extrabold text-white shadow-[0_10px_24px_rgba(8,121,184,.16)] [&>span]:text-[20px]" href="#contacto">Pedir agua ahora <span>→</span></a>
						<a class="border-b border-white/60 px-0 py-1.75 font-extrabold text-white" href="#catalogo">Ver productos</a>
					</div>
					<div class="mt-11.5 flex justify-center items-center gap-9.5 max-[1000px]:gap-4.5 max-[480px]:flex-wrap max-[480px]:gap-3">
						<div class="flex justify-center items-center gap-2.5 max-[480px]:w-[45%]"><strong class="font-[Manrope] text-[30px] font-extrabold text-sky-300">+</strong><span class="text-[11px] font-bold leading-[1.3] text-white/90">10 años<br />de experiencia</span></div>
						<div class="flex justify-center items-center gap-2.5 max-[480px]:w-[45%]"><strong class="font-[Manrope] text-[30px] font-extrabold text-sky-300">✓</strong><span class="text-[11px] font-bold leading-[1.3] text-white/90">Entrega<br />segura</span></div>
						<div class="flex justify-center items-center gap-2.5 max-[480px]:w-[45%]"><strong class="font-[Manrope] text-[30px] font-extrabold text-sky-300">11</strong><span class="text-[11px] font-bold leading-[1.3] text-white/90">Distritos<br />cubiertos</span></div>
					</div>
					<div class="animate-[bounce_2s_ease_infinite] text-white mt-20 max-[480px]:mt-5">
						<span class="uppercase">Descubre más</span>
						<div class="w-0.5 h-10 bg-linear-to-b from-white/60 to-transparent m-auto"></div>
					</div>
				</div>
			</section>

			<section class="px-[7%] py-20.5 max-[760px]:px-[5%] max-[760px]:py-15" id="catalogo">
				<div class="mx-auto mb-8.5 flex max-w-300 items-end justify-between max-[760px]:items-start">
					<div>
						<p class="mb-3.5 text-[12px] font-extrabold tracking-[2.2px] text-[#0879b8]">NUESTROS PRODUCTOS</p>
						<h2 class="m-0 font-[Manrope] text-[42px] font-extrabold leading-[1.1] tracking-[-1.5px] text-[#123d57] max-[760px]:text-[34px] max-[480px]:text-[32px]">Elige tu agua ideal</h2>
					</div>
					<a class="border-b border-[#a6c5d5] pb-1.5 text-[14px] font-extrabold text-[#0879b8] max-[760px]:hidden" href="#contacto">Ver catálogo completo <span class="text-[20px]">→</span></a>
				</div>
				<div class="mx-auto grid max-w-300 grid-cols-4 gap-4.5 max-[1000px]:grid-cols-2 max-[760px]:grid-cols-2 max-[760px]:gap-2.5">
					{products.map((product, index) => (
						<article class="group min-h-87.5 cursor-pointer rounded-lg border border-[#e7eff2] bg-[#f8fcfd] px-6 py-6 text-center transition-colors duration-300 hover:border-[#acd7e7] hover:bg-[#eaf4f7] max-[760px]:px-2 max-[480px]:min-h-80 motion-reduce:transition-none">
							<div class="relative mx-auto h-55 w-37.5 origin-bottom drop-shadow-[0_16px_8px_rgba(18,78,107,.09)] max-[480px]:scale-[.82]">
								<img src={imagen_principal.src} alt={product.name} class="relative h-full w-full object-contain transition-transform duration-300 ease-out group-hover:-translate-y-2 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:transform-none" />
							</div>
							<p class="mb-0.5 mt-2 text-[13px] text-[#75909d]">{product.name}</p>
							<h3 class="mb-3 mt-0 font-[Manrope] text-[20px] font-extrabold text-[#123d57]">{product.volume}</h3>
							<a class="text-[13px] font-extrabold text-[#0879b8]" href="#contacto" aria-label={`Solicitar ${product.name}`}>Solicitar <span class="text-[20px]">→</span></a>
						</article>
					))}
				</div>
			</section>

			<section class="grid min-h-175 grid-cols-[58%_42%] bg-[#f1f8fa] max-[760px]:grid-cols-1" id="cobertura">
				<div class="relative overflow-hidden bg-[linear-gradient(135deg,#d7edf3,#edf7f8)] max-[760px]:min-h-87.5" aria-label="Mapa ilustrado de zonas de cobertura">
					<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5771.455572434618!2d-76.1331575251653!3d-13.416342263150792!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91101689e5b38adf%3A0xee4951083d82d8d8!2sPlaza%20de%20Armas%20de%20Chincha!5e0!3m2!1sen!2spe!4v1794331119828!5m2!1sen!2spe" class="w-full h-full border-0" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
				</div>
				<div class="bg-[#edf7fa] px-[10%] py-18 pb-15 max-[760px]:px-[6%] max-[760px]:py-15">
					<p class="mb-3.5 text-[12px] font-extrabold tracking-[2.2px] text-[#0879b8]">COBERTURA</p>
					<h2 class="m-0 font-[Manrope] text-[42px] font-extrabold leading-[1.1] tracking-[-1.5px] text-[#123d57] max-[760px]:text-[34px]">Entregamos en<br />todo Chincha</h2>
					<p class="mb-5 mt-5 max-w-107.5 leading-[1.7] text-[#678390]">Llegamos a más distritos con puntualidad y el mejor servicio. Consulta si tu zona está cubierta.</p>
					<div class="mb-7 mt-5 grid grid-cols-2 gap-2.5 text-[13px] font-bold text-[#527588] [&>span]:before:mr-2 [&>span]:before:text-[#0879b8] [&>span]:before:content-['✓']"><span>Chincha Alta</span><span>Chincha Baja</span><span>Alto Laran</span><span>Pueblo Nuevo</span></div>
					<a class="inline-flex min-h-13 items-center justify-center gap-5.5 rounded-md border-0 bg-[#123d57] px-5.5 font-extrabold text-white shadow-[0_10px_24px_rgba(8,121,184,.16)] transition-[background-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:bg-[#0879b8] hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0879b8] motion-reduce:transition-none motion-reduce:hover:transform-none [&>span]:text-[20px]" href="#contacto">Consultar mi zona <span>→</span></a>
				</div>
			</section>

			<section class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] items-stretch gap-[clamp(32px,6vw,80px)] overflow-hidden bg-[#123d57] px-[7%] pt-20 text-white max-[900px]:grid-cols-1 max-[900px]:gap-10 max-[760px]:px-[5%] max-[760px]:pt-20" id="contacto">
				<div class="min-w-0 pb-20 max-[900px]:pb-0">
					<p class="mb-3.5 text-[12px] font-extrabold tracking-[2.2px] text-[#72c7e7]">PIDE TU AGUA</p>
					<h2 class="m-0 font-[Manrope] text-[42px] font-extrabold leading-[1.1] tracking-[-1.5px] text-white max-[760px]:text-[34px]">Agua fresca,<br />a un mensaje de distancia</h2>
					<p class="mb-7.5 mt-5 max-w-110 leading-[1.7] text-[#b2c7d1]">Completa tus datos y coordinaremos tu pedido de la manera más rápida.</p>
				<form class="order-form grid min-w-0 grid-cols-2 gap-x-5 gap-y-5 rounded-2xl border border-white/60 bg-white p-8 text-[#183b50] shadow-2xl shadow-black/20 max-[900px]:mx-auto max-[900px]:w-full max-[900px]:max-w-200 max-sm:grid-cols-1 max-sm:gap-4 max-[480px]:p-5">
					<div class="col-span-2 mb-1 max-sm:col-span-1">
						<h3 class="m-0 font-[Manrope] text-2xl font-extrabold text-[#123d57]">Solicita tu pedido</h3>
						<p class="mb-0 mt-1 text-sm leading-6 text-[#718995]">Déjanos tus datos y nos pondremos en contacto contigo.</p>
					</div>
					<label class="flex min-w-0 flex-col gap-2 text-[13px] font-bold text-[#264b60]">Nombre completo<input class="h-12.5 w-full rounded-lg border border-[#d8e3e7] bg-[#f8fbfc] px-4 font-[DM_Sans] text-sm font-medium text-[#183b50] outline-none transition placeholder:text-[#8ba0aa] focus:border-[#0879b8] focus:bg-white focus:ring-4 focus:ring-[#0879b8]/10" type="text" name="nombre" autocomplete="name" placeholder="Tu nombre" required /></label>
					<label class="flex min-w-0 flex-col gap-2 text-[13px] font-bold text-[#264b60]">Distrito<input class="h-12.5 w-full rounded-lg border border-[#d8e3e7] bg-[#f8fbfc] px-4 font-[DM_Sans] text-sm font-medium text-[#183b50] outline-none transition placeholder:text-[#8ba0aa] focus:border-[#0879b8] focus:bg-white focus:ring-4 focus:ring-[#0879b8]/10" type="text" name="distrito" autocomplete="address-level2" placeholder="Ej. Chincha Alta" required /></label>
					<label class="flex min-w-0 flex-col gap-2 text-[13px] font-bold text-[#264b60]">Teléfono<input class="h-12.5 w-full rounded-lg border border-[#d8e3e7] bg-[#f8fbfc] px-4 font-[DM_Sans] text-sm font-medium text-[#183b50] outline-none transition placeholder:text-[#8ba0aa] focus:border-[#0879b8] focus:bg-white focus:ring-4 focus:ring-[#0879b8]/10" type="tel" name="telefono" autocomplete="tel" inputmode="tel" placeholder="+51 999 999 999" required /></label>
					<label class="flex min-w-0 flex-col gap-2 text-[13px] font-bold text-[#264b60]">Producto
						<select class="h-12.5 w-full rounded-lg border border-[#d8e3e7] bg-[#f8fbfc] px-4 font-[DM_Sans] text-sm font-medium text-[#183b50] outline-none transition focus:border-[#0879b8] focus:bg-white focus:ring-4 focus:ring-[#0879b8]/10" name="producto">
							<option>Bidón retornable 20 L</option>
							<option>Garrafón sin retorno 20 L</option>
							<option>Botella familiar 6 L</option>
							<option>Pack individual 12 x 500 ml</option>
						</select>
					</label>
					<button class="col-span-2 mt-1 inline-flex min-h-13.5 w-full cursor-pointer items-center justify-center gap-3 rounded-lg border-0 bg-[#0879b8] px-6 font-extrabold text-white shadow-[0_10px_24px_rgba(8,121,184,.2)] transition-[background-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:bg-[#06699f] hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0879b8] motion-reduce:transition-none motion-reduce:hover:transform-none max-sm:col-span-1 [&>span]:text-xl" type="submit">Enviar pedido <span>→</span></button>
				</form>
					<div class="my-10 flex items-center gap-3.5">
						<span class="grid size-12 shrink-0 place-items-center rounded-full bg-[#1e5a75] text-lg" aria-hidden="true">☎</span>
						<div><small class="block text-[#9db4c0]">También puedes llamarnos</small><strong class="text-[18px]">(01) 555-0123</strong></div>
					</div>
				</div>
					<img src={imagen_contactos.src} alt="Imagen de contacto" class="mx-auto block h-auto max-h-220 min-w-0 w-full max-w-full self-end rounded-t-2xl object-cover object-top max-[900px]:hidden" />

			</section>

			<section class="flex min-h-36.25 items-center justify-between border-b border-[#d7e6eb] bg-[#e9f4f7] px-[7%] py-8.5 max-[760px]:flex-col max-[760px]:items-start max-[760px]:gap-5" id="reclamaciones">
				<div class="flex items-center gap-4.5 max-[760px]:items-start">
					<span class="grid size-14.5 place-items-center rounded-full bg-white text-[25px]">📖</span>
					<div><h2 class="m-0 font-[Manrope] text-[24px] font-extrabold leading-[1.1] tracking-[-.5px] text-[#123d57] max-[480px]:text-[21px]">Libro de reclamaciones</h2><p class="mb-0 mt-1.75 max-w-75 text-[14px] text-[#718995]">Tu opinión es importante. Registra aquí tu queja o reclamo.</p></div>
				</div>
				<a class="border-b border-[#a6c5d5] pb-1.5 text-[14px] font-extrabold text-[#0879b8]" href="#">Ingresar reclamo <span>→</span></a>
			</section>
		</main>
		<footer class="flex h-27.5 items-center justify-between px-[7%] text-[12px] text-[#78909b] max-[760px]:h-auto flex-wrap gap-5 py-7.5 max-[480px]:flex-col max-[480px]:items-start">
			<a class="flex origin-left scale-[.85] min-w-51.25 items-center gap-2.25" href="#">
				<img src={logo.src} alt="Logo de Agua Santa María" class="h-7.25" />
			</a>
			<p>© 2026 Agua Santa María. Todos los derechos reservados.</p>
			<div class="flex gap-6"><a href="#">Términos</a><a href="#">Privacidad</a></div>
		</footer>

		<script>
			const header = document.querySelector<HTMLElement>(".site-header");
			const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav > a");
			const menuIconBars = document.querySelectorAll<HTMLElement>(".menu-button > span");
			const updateHeaderOnScroll = () => {
				const isScrolled = window.scrollY > 10;
				header?.classList.toggle("bg-white/96", isScrolled);
				header?.classList.toggle("border-[#edf2f4]", isScrolled);
				header?.classList.toggle("bg-transparent", !isScrolled);
				header?.classList.toggle("border-transparent", !isScrolled);

				navLinks.forEach((link) => {
					link.classList.toggle("text-white", !isScrolled);
					link.classList.toggle("!text-[#111827]", isScrolled);
				});
				menuIconBars.forEach((bar) => {
					bar.classList.toggle("bg-white", !isScrolled);
					bar.classList.toggle("bg-[#111827]", isScrolled);
				});
			};

			updateHeaderOnScroll();
			window.addEventListener("scroll", updateHeaderOnScroll, { passive: true });

			const revealOnScroll = document.querySelectorAll<HTMLElement>(
			'main > section:not(#inicio) :is(h2, h3, p, img):not(article *)',
			);
			const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

			if ("IntersectionObserver" in window && !prefersReducedMotion.matches) {
				const revealObserver = new IntersectionObserver((entries, observer) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;

						entry.target.classList.remove("translate-y-[30px]", "opacity-0");
						entry.target.classList.add("translate-y-[0]", "opacity-100");
						observer.unobserve(entry.target);
					}
				}, { threshold: 0.1, rootMargin: "0px 0px -5% 0px" });

				for (const element of revealOnScroll) {
					element.classList.add(
						"translate-y-[30px]",
						"opacity-0",
						"transition-[opacity,transform]",
						"duration-900",
						"ease-out",
					);
					revealObserver.observe(element);
				}
			}

			const menuButton = document.querySelector(".menu-button");
			const nav = document.querySelector(".nav");
			const mobileMenuQuery = window.matchMedia("(max-width: 760px)");
			const setMobileMenuOpen = (open: boolean) => {
				if (!menuButton || !nav) return;

				menuButton.setAttribute("aria-expanded", String(open));
				menuButton.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
				nav.setAttribute("aria-hidden", String(mobileMenuQuery.matches && !open));
				nav.inert = mobileMenuQuery.matches && !open;
				nav.classList.toggle("max-[760px]:max-h-0", !open);
				nav.classList.toggle("max-[760px]:max-h-80", open);
				nav.classList.toggle("max-[760px]:py-0", !open);
				nav.classList.toggle("max-[760px]:py-5", open);
				nav.classList.toggle("max-[760px]:opacity-0", !open);
				nav.classList.toggle("max-[760px]:opacity-100", open);
				nav.classList.toggle("max-[760px]:-translate-y-2", !open);
				nav.classList.toggle("max-[760px]:translate-y-0", open);
				nav.classList.toggle("max-[760px]:pointer-events-none", !open);
				nav.classList.toggle("max-[760px]:pointer-events-auto", open);
			};

			setMobileMenuOpen(false);
			mobileMenuQuery.addEventListener("change", () => setMobileMenuOpen(false));
			menuButton?.addEventListener("click", () => {
				const open = menuButton.getAttribute("aria-expanded") === "true";
				setMobileMenuOpen(!open);
			});
			navLinks.forEach((link) => {
				link.addEventListener("click", () => {
					setMobileMenuOpen(false);
				});
			});
			document.querySelector(".order-form")?.addEventListener("submit", (event) => {
				event.preventDefault();
				const form = event.currentTarget;
				if (!(form instanceof HTMLFormElement)) return;
				const button = form.querySelector("button");
				if (!button) return;
				button.textContent = "¡Pedido enviado!";
				setTimeout(() => { button.innerHTML = "Enviar pedido <span>→</span>"; form.reset(); }, 2500);
			});
		</script>
	</body>
</html>
